# 复制为 .env；真实值只放本机或部署平台，禁止提交。

# application
APP_ENV=development
APP_NAME=宜游轩ERP
APP_VERSION=1.0.1
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# security — 生产环境必须替换为随机强密钥，且长度不少于 32 位
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# database — 唯一支持 PostgreSQL（SQLite 通道已下线）
# 开发库与测试库必须分开：跑 pytest 会 TRUNCATE 全表，库名必须含 test
DATABASE_URL=postgresql+psycopg://erp_user:replace-me@127.0.0.1:5433/heijin_erp
# 跑测试优先读这个；注释掉则回落到 DATABASE_URL（仍强制要求库名含 test）
TEST_DATABASE_URL=postgresql+psycopg://erp_user:replace-me@127.0.0.1:5433/heijin_erp_test

# 本机自建 PG 容器（deploy/container/compose.yaml，由 deploy/scripts/pg_container.sh 启动）
# 缺这三项 compose 会拒绝启动——比用占位值悄悄起一个新卷要好。
ERP_PG_USER=erp_user
ERP_PG_PASSWORD=replace-me
ERP_PG_PORT=5433
ERP_PG_CONTAINER=heijin-db-1
# WAL 归档落盘目录（宿主机 bind mount 进容器 /wal_archive），必须是绝对路径
ERP_PG_ARCHIVE_HOST=/absolute/path/to/backups/pg_wal_live

# CORS — 多个来源以英文逗号分隔；生产不得使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# frontend
# 开发环境走前端同源代理，避免页面端口变化导致 CORS / PNA 拦截
VITE_API_BASE=/api/v1
