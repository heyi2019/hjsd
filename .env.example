# 复制为 .env；真实值只放本机或部署平台，禁止提交。

# application
APP_ENV=development
APP_NAME=宜游轩ERP
APP_VERSION=1.0.1
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# security — 生产环境必须替换为随机强密钥，且长度不少于 32 位
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# database — 先使用 SQLite；生产使用 PostgreSQL URL
DATABASE_URL=sqlite:///./data/heijin_erp_v1.db
# DATABASE_URL=postgresql+psycopg://erp_user:replace-me@127.0.0.1:5432/heijin_erp

# SQLite 运行参数（仅 sqlite 生效；0 表示沿用 SQLite 默认，即不覆盖该项）
# SYNCHRONOUS：WAL 下推荐 NORMAL，提交不再逐次 fsync；改 FULL 则每次提交都落盘
# CACHE_SIZE_KB：页缓存，默认 16000=16MB（旧值 2MB 装不下现有库）
# MMAP_SIZE_MB：只读映射窗口，默认 64MB
# TEMP_STORE：MEMORY 让报表排序走内存，FILE 则写临时文件
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_CACHE_SIZE_KB=16000
SQLITE_MMAP_SIZE_MB=64
SQLITE_TEMP_STORE=MEMORY

# CORS — 多个来源以英文逗号分隔；生产不得使用 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# frontend
# 开发环境走前端同源代理，避免页面端口变化导致 CORS / PNA 拦截
VITE_API_BASE=/api/v1
