__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
.pytest_cache/
node_modules/
dist/
.env
**/.env.local
.env.*-test
.env.*.test
.env.postgres-test
# 任意 .env 变体（.env.release / .env.stage 等同样含库口令与 JWT 密钥），
# 除模板 .env.example 外一律不入库。此前只忽略精确文件名，新变体会被 git 静默跟踪。
.env.*
!.env.example
# .env 的临时备份同样含库口令，禁止入库（11-02 数据恢复期间产生）
.env.bak*
.env.*.bak*
*.env.bak*
frontend/test-results/
# SQLite 运行产物：由scripts/migrate_v2.py 从原始 JSON 重建，不入版本库
*.db
*.db-journal
*.db-wal
*.db-shm

# 测试覆盖率产物（曾被 02:15 checkout checkpoint 误收，特此显式忽略）
.coverage
.coverage.*
coverage.json
coverage.xml
coverage/
htmlcov/
.pytest_cache/

# Playwright 报告与浏览器缓存产物
/frontend/playwright-report/
/frontend/playwright/.cache/

# Vitest JSON 报告产物（--reporter=json 输出目录）
/frontend/.vitest/

# 运行期目录：日志与截图产物，不入版本库
/logs/*
!/logs/.gitkeep
/outputs/*
!/outputs/.gitkeep

# 附件上传运行产物，不纳入代码版本库
/backend/data/attachments/*

# 数据库备份运行产物，不纳入代码版本库
/backend/data/backups/*
# 迁移/压平前的 tarball 备份（含历史迁移快照），同样不入库（git 历史已留档）
/backend/backups/

# 迁移前的临时库备份（带时间戳后缀，*.db 规则匹配不到）
/backend/data/*.bak*

# 根目录本地数据库备份，不入版本库
/backups/

# WorkBuddy 记忆目录，与项目代码无关
.workbuddy/
