__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
.pytest_cache/
node_modules/
dist/
.env
**/.env.local
.env.*-test
.env.*.test
.env.postgres-test
# 任意 .env 变体（.env.release / .env.stage 等同样含库口令与 JWT 密钥），
# 除模板 .env.example 外一律不入库。此前只忽略精确文件名，新变体会被 git 静默跟踪。
.env.*
!.env.example
# .env 的临时备份同样含库口令，禁止入库（11-02 数据恢复期间产生）
.env.bak*
.env.*.bak*
*.env.bak*
frontend/test-results/
# SQLite 运行产物：由scripts/migrate_v2.py 从原始 JSON 重建，不入版本库
*.db
*.db-journal
*.db-wal
*.db-shm

# 测试覆盖率产物（曾被 02:15 checkout checkpoint 误收，特此显式忽略）
.coverage
.coverage.*
coverage.json
coverage.xml
coverage/
htmlcov/

# Playwright 报告与浏览器缓存产物
/frontend/playwright-report/
/frontend/playwright/.cache/

# Vitest JSON 报告产物（--reporter=json 输出目录）
/frontend/.vitest/

# 运行期目录：日志与截图产物，不入版本库
/logs/*
!/logs/.gitkeep
# outputs：运行产物目录。11-11 清退一次性导入脚本后，入库的只剩目录说明与
# legacy_import 的核对脚本；csv/xlsx/json 等数据产物一律不入库。
/outputs/*
!/outputs/README.md
# 父目录被 /outputs/* 忽略后，子文件需先放行父目录才能被 ! 救回
/outputs/*/
!/outputs/legacy_import/
/outputs/legacy_import/*
!/outputs/legacy_import/*.py

# 附件上传运行产物，不纳入代码版本库
/backend/data/attachments/*

# 数据库备份运行产物，不纳入代码版本库
/backend/data/backups/*
# 迁移/压平前的 tarball 备份（含历史迁移快照），同样不入库（git 历史已留档）
/backend/backups/

# 迁移前的临时库备份（带时间戳后缀，*.db 规则匹配不到）
/backend/data/*.bak*

# 根目录本地数据库备份，不入版本库
/backups/

# WorkBuddy 记忆目录，与项目代码无关
.workbuddy/

# 测试执行结果（按 run_id 追加，历史不覆盖；用例定义为 测试用例库.csv，二者分离）
docs/testing/测试结果库/results.jsonl
# 裁剪归档：被 trim_test_results.py 移出主文件的历史行（gzip），只供追查，不进版本库
docs/testing/测试结果库/archive/

# 测试生成物的内部索引：nodeid ↔ 测试编号的映射表，每次跑测试/跑生成脚本都会重写。
# CI（backend-gate.yml）与本地均由 scripts/gen_test_case_library.py 重建，入库只会带来
# 每次执行的无意义 diff（约 584KB）。测试报告.md 与 测试用例库.md/.csv 仍入库，
# 因为它们是「当前测了什么、结果如何」的可读快照。
tests/backend/_report/case_index.json
tests/backend/_report/case_number_map.json
