__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
.pytest_cache/
node_modules/
dist/
.env
**/.env.local
frontend/test-results/
# SQLite 运行产物：由scripts/migrate_v2.py 从原始 JSON 重建，不入版本库
*.db
*.db-journal
*.db-wal
*.db-shm

# 测试覆盖率产物（曾被 02:15 checkout checkpoint 误收，特此显式忽略）
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
.pytest_cache/

# Playwright 报告与浏览器缓存产物
/frontend/playwright-report/
/frontend/playwright/.cache/

# 运行期目录：日志、运行时状态、监控数据、截图产物，不入版本库
/logs/*
!/logs/.gitkeep
/runtime/*
!/runtime/.gitkeep
/monitor/*
!/monitor/.gitkeep
/outputs/*
!/outputs/.gitkeep
/business_output/*
!/business_output/.gitkeep

# 附件上传运行产物，不纳入代码版本库
/backend/data/attachments/*

# 数据库备份运行产物，不纳入代码版本库
/backend/data/backups/*

# WorkBuddy 记忆目录，与项目代码无关
.workbuddy/
