# Import Linter 契约（2026-11-17 架构评估 P0-B 落地）
#
# 背景：orders 被五个域引用是最上游；但实测发现三处双向依赖（环），
# 代码里已出现「函数内延迟 import」补丁（events.py:60 / router.py:249 / deletion.py:84），
# 这是循环依赖的典型症状。本文件固化合法依赖方向：
#
#   合法方向（下游 -> 上游实体域）：
#     finance / value_added_services / policy / reporting / stocks -> orders
#     reporting / value_added_services -> finance
#
#   禁止的反向边（P0-A 已全部消灭，2026-11-18，三批归位）：
#     orders -> finance          已归位：会计属性移 domain 层、余额端点移 finance 域、
#                                初始成本挂账改 app/orders/collaboration.py 注册点
#     orders -> value_added_services 已归位：SELL 回收联动改 collaboration 注册点
#     stocks -> orders           已归位：FORM_SCOPES 移 domain 层（断 lists 间接环）；
#                                导出/台账/删除联动改 app/stocks/collaboration.py 注册点
#
# 运行：backend 目录下执行 lint-imports（CI lint-gate 同步强制）。
# 豁免纪律：整边豁免（行级豁免对延迟 import / 多符号 as 导入匹配不稳定）——
#           归位一批、收紧一批，使豁免清单单调收紧（与 lint_baseline.txt 同一套方法论）。

[importlinter]
root_package = app

[importlinter:contract:orders-not-import-finance]
name = orders 不得依赖 finance（合法方向只有 finance -> orders）
type = forbidden
source_modules =
    app.orders
forbidden_modules =
    app.finance

[importlinter:contract:orders-not-import-value-added-services]
name = orders 不得依赖 value_added_services（合法方向只有 value_added_services -> orders）
type = forbidden
source_modules =
    app.orders
forbidden_modules =
    app.value_added_services

[importlinter:contract:stocks-not-import-orders]
name = stocks 不得依赖 orders（合法方向只有 orders -> stocks）
type = forbidden
source_modules =
    app.stocks
forbidden_modules =
    app.orders
