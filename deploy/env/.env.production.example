# ===== 宜游轩 ERP 生产环境变量模板 =====
# 复制为 deploy/.env 并填入真实值；deploy/.env 不入库。
#   cp env/.env.production.example .env
#
# 说明：
#  - pydantic-settings 中环境变量优先级：系统环境变量 > .env > 默认值
#  - 此处的值会被 docker compose env_file 注入 backend 容器，覆盖任何镜像内默认值

# 运行环境（production 会关闭 CORS 本地任意端口放宽）
APP_ENV=production

# 当前正式库：ECS 上的 SQLite 持久化文件；不要改指向旧 heijin.db/heijin_v2.db。
# PostgreSQL 迁移完成前，生产仍使用该 v1 库。
DATABASE_URL=sqlite:///./data/heijin_erp_v1.db

# 安全：JWT 密钥必须替换！生成命令：
#   openssl rand -hex 32
# 长度不少于 32 位，且每次部署/轮换都重新生成并重启。
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS：填你的前端域名。使用 nginx 同源反代时也可留空，
# 但显式写上便于后端做来源校验（逗号分隔多个来源）。
CORS_ORIGINS=https://your-domain.com
