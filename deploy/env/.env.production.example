# ===== 宜游轩 ERP 生产环境变量模板 =====
# 复制为 deploy/.env 并填入真实值；deploy/.env 不入库。
#   cp env/.env.production.example .env
#
# 说明：
#  - pydantic-settings 中环境变量优先级：系统环境变量 > .env > 默认值
#  - 此处的值会被 docker compose env_file 注入 backend 容器，覆盖任何镜像内默认值

# 运行环境（production 会关闭 CORS 本地任意端口放宽）
APP_ENV=production

# 版本号唯一事实源是 backend/app/version.py，deploy.sh 解析后 export APP_VERSION
# （用于镜像 tag 与 /api/v1/health 显示）。shell 变量优先级高于 .env，因此脚本部署
# 永远以 version.py 为准，此处设值不会覆盖它。
# 仅在同一台机上会有人手工 `docker compose up` 时，才建议在此**显式钉住**版本：
# compose 写的是 ${APP_VERSION:-latest}，缺省会回落到 :latest；一旦 :latest 是坏镜像
# （曾出现 0 字节的 heijin-backend:latest），手工 up 会报
# `descriptor is neither a manifest or index` 并让容器起不来。
# APP_VERSION=1.0.0

# 当前正式库：同一 ECS 上的 PostgreSQL 容器；数据库名、用户和密码必须一致。
# 不要把 5432 暴露到公网，DBeaver 请通过 SSH 隧道连接。
POSTGRES_DB=heijin_erp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+psycopg://erp_app:replace-with-a-random-password@db:5432/heijin_erp

# 安全：JWT 密钥必须替换！生成命令：
#   openssl rand -hex 32
# 长度不少于 32 位，且每次部署/轮换都重新生成并重启。
# 下面故意保留 replace-with- 前缀：settings.py 会拒绝以此开头的值，
# 忘记替换时服务启动即报错，而不是带着一个公开字符串跑起来。
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS：填你的前端域名（逗号分隔多个）。
# 本编排中前端由 nginx 同源反代 /api/v1/ 到 backend（见 frontend/nginx.conf），
# 浏览器请求不跨域，故**保持下面留空即可**；仅当前端部署在独立域名/端口时才需要填。
# 生产环境禁止使用通配符 *（settings 启动校验会直接拒绝）。
# 注意：留空（`CORS_ORIGINS=`）得到空列表 []；若整行删掉则回落到 settings.py 的
# 开发默认值（4 个 localhost），故**保留空行、不要删行**。
# 不要填占位符域名——它会被当真值写进白名单。
CORS_ORIGINS=

# 管理员初始密码：**不要写在此文件**。
# 本文件被 docker-compose 的 env_file 加载，写在里面的变量会进入 backend 容器的常驻进程环境
# （/proc/1/environ 长期可见）。正确做法是部署时临时传入：
#   export ADMIN_PASSWORD='至少 12 位强密码'
#   ./scripts/deploy.sh
# deploy.sh 只在 create_admin 那一步用 -e 显式传入，不会写入编排配置。
