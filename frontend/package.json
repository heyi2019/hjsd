{
  "name": "heijin-erp-web",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/ui_guards.mjs && tsc -p tsconfig.app.json && vite build",
    "check": "node scripts/ui_guards.mjs && tsc",
    "test": "vitest run --project=quick",
    "test:unit": "vitest run --project=fast",
    "test:panel": "node scripts/test-panel.mjs",
    "audit:ux": "node scripts/ux-audit.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "test:ci": "node scripts/test-full-sharded.mjs --all",
    "test:fast": "vitest run --project=fast",
    "test:quick": "vitest run --project=quick",
    "test:react": "vitest run --project=react",
    "test:timing": "node scripts/test-timing.mjs",
    "test:react-deep": "vitest run --project=react-deep",
    "test:react-deep:shard": "node scripts/test-deep-shard.mjs",
    "test:full": "node scripts/test-full-sharded.mjs",
    "test:full:deep": "node scripts/test-full-sharded.mjs --deep-only",
    "test:full:all": "node scripts/test-full-sharded.mjs --all",
    "test:full:serial": "vitest run",
    "test:serial": "vitest run --project=react --no-file-parallelism",
    "test:watch": "vitest",
    "test:regression:fast": "npm run check && npm run test:fast",
    "guard": "node scripts/ui_guards.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@tencent-ai/workbuddy-cloud-sdk": "0.1.4-dev.ca27990.202610161713",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
